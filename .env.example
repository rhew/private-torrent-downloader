APP_UID=1000
APP_GID=1000
TZ=America/New_York
DOWNLOADS_DIR=./downloads
LIBRARY_DIR=./library
JACKETT_CONFIG_DIR=./jackett-config
CURATOR_PORT=8787
VPNGATE_MIN_SPEED=5000000
VPNGATE_MAX_PING=300
VPNGATE_MIN_UPTIME=86400
# VPNGATE_COUNTRY=US
VIDEO_GID=44
RENDER_GID=992

# Optional. If set, clients must pass the same value with CURATOR_TOKEN or --token.
CURATOR_TOKEN=

